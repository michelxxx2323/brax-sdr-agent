# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# Os nomes dos modelos Claude NÃO ficam aqui: eles ficam no arquivo de configuração (Fase 2).

# --- Anthropic (Claude API) — Fase 2 ---
ANTHROPIC_API_KEY=

# --- Supabase (leads, conversas, memória) — Fase 2 ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail (Gmail API) — Fase 3 ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REMETENTE=

# --- WhatsApp (Meta Cloud API) — Fase 4 ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- HubSpot (CRM) — Fase 5 ---
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Slack (aprovação humana) — Fase 5 ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CANAL_APROVACAO=

# --- Links públicos usados pelo agente ---
BRAX_LINK_APP=
BRAX_LINK_AGENDA_EXECUTIVO=
