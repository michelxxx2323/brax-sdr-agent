# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# Os nomes padrão dos modelos ficam em src/brax_sdr/config.py.

# --- Anthropic (Claude API) — Fase 2 ---
ANTHROPIC_API_KEY=

# Opcional: trocar os modelos sem mexer no código (ex.: para comparar na Fase 6).
# Deixe vazio para usar o padrão do config.py.
BRAX_MODELO_CONVERSA=
BRAX_MODELO_AVANCADO=

# --- Supabase (leads, conversas, memória) — Fase 2 ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail (Gmail API) — Fase 3 ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REMETENTE=
# Opcional: só responde a estes remetentes (separados por vírgula). Vazio = responde a todos.
EMAIL_REMETENTES_PERMITIDOS=
# Só para testar o follow-up: 1 dia útil vira N minutos (ex.: 1). Deixe vazio em uso normal.
BRAX_FOLLOWUP_MINUTOS_TESTE=

# --- WhatsApp (Meta Cloud API) — Fase 4 ---
# simulado (padrão: sem número, testa com simular_whatsapp.py) ou meta (WhatsApp Cloud API real)
WHATSAPP_MODO=simulado
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Modo meta: "true" envia de verdade. Vazio/false: processa e só mostra no terminal o que teria enviado.
WHATSAPP_ENVIO_HABILITADO=

# --- HubSpot (CRM) — Fase 5 ---
# Chave de serviço (Desenvolvimento → Chaves → Chaves de serviço), com os escopos listados no README
HUBSPOT_ACCESS_TOKEN=

# --- Slack (aprovação humana) — Fase 5 ---
# Bot User OAuth Token (xoxb-), App-Level Token com connections:write (xapp-) e o ID do canal (ex.: C0123ABCDEF)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CANAL_APROVACAO=

# --- Links públicos usados pelo agente ---
BRAX_LINK_APP=
BRAX_LINK_AGENDA_EXECUTIVO=
